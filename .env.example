TELEGRAM_BOT_TOKEN=
# Recommended: set your own chat ID before starting the bot.
# If empty, the first private /start pairs the bot with that chat.
TELEGRAM_CHAT_ID=

# Default: use your local Codex login/auth, not an OpenAI API key.
# Supported choices: codex, openai_api, gemini. Choose the bot's analyzer
# independently of the coding agent or editor you use to work on this project.
# Setup guide: docs/analysis.md. Check without making a model request:
# python3 -m scripts.check_analysis
ANALYSIS_PROVIDER=codex
CODEX_COMMAND=codex
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=medium
CODEX_PROFILE=
CODEX_TIMEOUT_SECONDS=45

# Alternative provider. Only needed if ANALYSIS_PROVIDER=openai_api.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=350

# Alternative provider. Only needed if ANALYSIS_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1024

# Profiles: general for companies across sectors, biotech for additional
# clinical-trial, FDA, and drug-safety rules. See docs/profiles.md.
WATCH_PROFILE=general

# Relative paths resolve from the working directory. Run from the project root.
# Leave DATABASE_PATH unset to reuse an existing legacy database automatically,
# or create company_watch.sqlite on a fresh install.
# DATABASE_PATH=company_watch.sqlite
SOURCES_PATH=sources.json
WATCHLIST_PATH=watched_tickers.txt
POLL_USER_AGENT=CompanyWatch/0.1
# SEC can reject generic user agents. Use a real contact string.
SEC_USER_AGENT=Your Name company-watch your-email@example.com
ALERT_THRESHOLD=55
MAX_ALERT_ITEM_AGE_HOURS=72
BASELINE_LOOP_SECONDS=2

# Automatic daily checks in America/New_York time, including weekends.
# No announced catalyst is needed. Empty DAILY_POLL_TIMES_ET disables them.
DAILY_POLL_TIMES_ET=06:00,06:30,07:00,07:30,08:00,08:30,09:00,09:30,13:00,16:00,16:05,16:30,17:00,17:30
DAILY_POLL_BEFORE_SECONDS=60
DAILY_POLL_AFTER_SECONDS=600
DAILY_POLL_INTERVAL_SECONDS=15
POLL_FETCH_WORKERS=4
